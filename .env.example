# Copy to .env and fill in.

# LLM — DeepSeek (open-weight) via LangChain init_chat_model
DEEPSEEK_API_KEY=sk-your-deepseek-key

# Qdrant: leave QDRANT_URL unset to use embedded local mode (./qdrant_data).
# Set it to use the Docker server (recommended for full BM25/IDF scoring).
# QDRANT_URL=http://localhost:6333

# Optional overrides (defaults live in config.py)
# COLLECTION_NAME=marketing_rag
# DENSE_MODEL=BAAI/bge-small-en-v1.5
# LLM_MODEL=deepseek-chat
